# Configuración local de los agentes. Copia este archivo a `agents/.env` y
# completa los tres valores vacíos de abajo:
#
#     cp agents/.env.example agents/.env
#
# `agents/.env` está en .gitignore a propósito: AGENT_SERVICE_TOKEN y
# CATALOG_DSN son secretos y este repositorio es público. En el engine
# desplegado no se usa este archivo — deploy.py lee estas mismas variables del
# entorno y las manda en deployment_spec.env (ver RUNTIME_ENV_KEYS).

# --- Vertex AI ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=agro-extension-digital-npe
GOOGLE_CLOUD_LOCATION=us-central1

# --- RAG: los datastores de Discovery Engine (nombres ya calificados) ---
DATASTORE_PP_ID=projects/agro-extension-digital-npe/locations/global/collections/default_collection/dataStores/0001-produccion-primaria_1745450565038
DATASTORE_AA_ID=projects/agro-extension-digital-npe/locations/global/collections/default_collection/dataStores/0001-adecuacion-agroindustrial_1745450263959
DATASTORE_GUIDES_ID=projects/agro-extension-digital-npe/locations/global/collections/default_collection/dataStores/0001-guias_1745450505033
DATASTORE_FAQ_ID=projects/agro-extension-digital-npe/locations/global/collections/default_collection/dataStores/0001-faq_1745450327301
DATASTORE_CHILEPRUNES_CL_ID=projects/agro-extension-digital-npe/locations/global/collections/default_collection/dataStores/0001-chileprunes-cl_1748096068703

# --- El expediente: /api/agent/* de la app ---
# Base sin barra final. En local, el `next dev` de la app.
CIRUELA_API_BASE=http://localhost:3100
# El mismo valor que AGENT_SERVICE_TOKEN en el .env.local de la app.
# SECRETO: no lo commitees.
AGENT_SERVICE_TOKEN=

# --- El catálogo: Postgres de Supabase, rol de sólo lectura ---
# DSN del rol agent_catalog_reader. SECRETO: lleva la contraseña.
# Ejemplo: postgresql://agent_catalog_reader:<password>@<host>:5432/postgres?sslmode=require
CATALOG_DSN=

# --- Knobs opcionales (si no los defines, manda el default del código) ---
# CATALOG_MAX_ROWS=200
# TOOL_MAX_RETRIES=3
# GEMINI_LOCATION=global
# AGENT_PLANNER=builtin
# AGENT_THINK_BUDGET=2048
