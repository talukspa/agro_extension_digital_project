{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "log_entry",
    "type": "object",
    "properties": {
        "name": {
            "title": "name",
            "type": "string"
        },
        "action": {
            "title": "action",
            "type": "string"
        },
        "format": {
            "oneOf": [
                { "$ref": "aplicacion_agroquimicos.json" },
                { "$ref": "aplicacion_fertilizantes.json" },
                { "$ref": "consumo_energetico.json" },
                { "$ref": "consumo_agua_proceso.json" },
                { "$ref": "riego.json" },
                { "$ref": "monitoreo_plagas_enfermedades_malezas.json" },
                { "$ref": "monitoreo_especies_exoticas.json" },
                { "$ref": "mantencion.json" },
                { "$ref": "aplicacion_sorbato_potasio_aceites_vegetales.json" },
                { "$ref": "humedad_suelo.json" },
                { "$ref": "labores_planta.json" },
                { "$ref": "calicata.json" },
                { "$ref": "labores_campo.json" }
            ]
        }
    },
    "required": ["name", "action", "format"]
}