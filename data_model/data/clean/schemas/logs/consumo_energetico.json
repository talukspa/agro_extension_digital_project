{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "consumo_energetico",
    "type": "object",
    "properties": {
        "monthly_energy_consumption_kwh": {
            "type": "string",
            "description": "Consumo energetico mensual (kWhe)"
        },
        "monthly_energy_cost": {
            "type": "string",
            "description": "Gasto en energia ($/mes)"
        },
        "energy_source_type": {
            "type": "string",
            "description": "Tipo de fuente de energia (diesel, gas, gasolina y/o energia electrica)"
        }
    }
}