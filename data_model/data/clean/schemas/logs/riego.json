{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "riego",
    "type": "object",
    "properties": {
        "crop": {
            "type": "string",
            "description": "Cultivo"
        },
        "irrigation_days_per_week": {
            "type": "string",
            "description": "Dias de riego en la semana"
        },
        "date": {
            "type": "string",
            "description": "Fecha"
        },
        "water_source": {
            "type": "string",
            "description": "Fuente de abastecimiento disponible (canal, pozo, suministro de agua potable, red aljibe, etc.)"
        },
        "sector": {
            "type": "string",
            "description": "Sector o cuartel"
        },
        "area": {
            "type": "string",
            "description": "Superficie"
        },
        "irrigation_time": {
            "type": "string",
            "description": "Tiempo de riego"
        },
        "daily_water_volume_liters": {
            "type": "string",
            "description": "Volumen de agua aplicado en el dia (litros)"
        }
    }
}