{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "calicata",
    "type": "object",
    "properties": {
        "execution_date": {
            "type": "string",
            "description": "Fecha de ejecucion"
        },
        "test_pit_number_or_code": {
            "type": "string",
            "description": "Numero o codigo de calicata"
        },
        "depth": {
            "type": "string",
            "description": "Profundidad"
        },
        "results_obtained": {
            "type": "string",
            "description": "Resultados obtenidos (nivel de humedad y caracteristicas del suelo)"
        },
        "sector_or_georeference": {
            "type": "string",
            "description": "Sector, cuartel o georreferenciacion"
        },
        "texture": {
            "type": "string",
            "description": "Textura (ej.: arcillosa, arenosa, etc.)"
        }
    }
}