{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "aplicacion_agroquimicos",
    "type": "object",
    "properties": {
        "label_color": {
            "type": "string",
            "description": "Color de la etiqueta"
        },
        "dosage": {
            "type": "string",
            "description": "Dosis"
        },
        "rain_event": {
            "type": "string",
            "description": "Evento de lluvia (SI/NO) (opcional)"
        },
        "date_time": {
            "type": "string",
            "description": "Fecha y hora"
        },
        "active_ingredient": {
            "type": "string",
            "description": "Ingrediente activo"
        },
        "application_method": {
            "type": "string",
            "description": "Metodo de aplicacion"
        },
        "product_name": {
            "type": "string",
            "description": "Nombre del producto"
        },
        "application_objective": {
            "type": "string",
            "description": "Objetivo de la aplicacion"
        },
        "reentry_period": {
            "type": "string",
            "description": "Periodo de reingreso"
        },
        "withdrawal_period": {
            "type": "string",
            "description": "Periodo de carencia"
        },
        "responsible_person": {
            "type": "string",
            "description": "Responsable"
        },
        "sector": {
            "type": "string",
            "description": "Sector o cuartel"
        },
        "ambient_temperature": {
            "type": "string",
            "description": "Temperatura ambiente (opcional)"
        },
        "wind_speed": {
            "type": "string",
            "description": "Velocidad del viento (opcional)"
        }
    }
}