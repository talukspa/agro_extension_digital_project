      "type": "integer",
      "description": "Identificador único para el auditor."
    },
    "auditor_name": {
      "type": "string",
      "description": "Nombre del auditor."
    },
    "auditor_email": {
      "type": "string",
      "format": "email",
      "description": "Dirección de correo electrónico del auditor."
    },
    "auditor_phone": {
      "type": "string",
      "description": "Número de teléfono del auditor."
    },
    "assigned_businesses": {
      "type": "array",
      "items": {
        "type": "string"
      },
