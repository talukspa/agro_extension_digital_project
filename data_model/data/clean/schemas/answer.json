{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "answer.json",
  "title": "Answer",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "action.json"
    },
    "answer_value": {
      "type": [
        "string",
        "number",
        "boolean",
        "array",
        "object"
      ],
      "description": "La respuesta real proporcionada por el usuario (el tipo de dato depende de la pregunta)."
    }
  },
  "required": [
    "action",
    "answer_value"
  ],
  "oneOf": [
    {
      "if": {
        "properties": {
          "action": {
            "properties": {
              "verification_type": {
                "const": "image"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "register": {
            "allOf": [
              {
                "$ref": "register.json"
              },
              {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "image_url"
                ]
              }
            ]
          }
        }
      },
      "else": false
    },
    {
      "if": {
        "properties": {
          "action": {
            "properties": {
              "verification_type": {
                "const": "document"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "register": {
            "allOf": [
              {
                "$ref": "register.json"
              },
              {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "document_url"
                ]
              }
            ]
          }
        }
      },
      "else": false
    },
    {
      "if": {
        "properties": {
          "action": {
            "properties": {
              "verification_type": {
                "const": "log"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "register": {
            "allOf": [
              {
                "$ref": "register.json"
              },
              {
                "type": "object",
                "properties": {
                  "logs": {
                    "type": "array",
                    "items": {
                      "$ref": "logs.json"
                    }
                  }
                },
                "required": [
                  "logs"
                ]
              }
            ]
          }
        }
      },
      "else": false
    }
  ]
}